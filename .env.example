# GitHub Contribution City Configuration
# Copy this file to .env and adjust variables as needed

# GitHub Personal Access Token (PAT) for GraphQL API queries
# Required for private contributions or high rate-limits. Public data can be fetched with basic rate limits.
GITHUB_TOKEN=

# Default GitHub username to visualize
GITHUB_USERNAME=torvalds

# City Generation Settings
# Number of weeks to render (4 - 53, default: 53)
CITY_WEEKS=53

# Maximum building height (3 - 30, default: 14)
CITY_MAX_HEIGHT=14

# Theme: github-dark, github-light, cyberpunk, mono, neon, matrix
CITY_THEME=github-dark

# Server configuration
PORT=8088
HOST=0.0.0.0
